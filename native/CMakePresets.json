{
  "version": 3,
  "cmakeMinimumRequired": {"major": 3, "minor": 21, "patch": 0},
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/native-${presetName}",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}
    },
    {
      "name": "windows-x64",
      "inherits": "base",
      "displayName": "Windows x64 (MSVC, static runtime; from a VS x64 developer prompt or native/build_win.cmd)",
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"},
      "cacheVariables": {"CMAKE_C_COMPILER": "cl", "CMAKE_CXX_COMPILER": "cl"}
    },
    {
      "name": "windows-x64-debug",
      "inherits": "windows-x64",
      "displayName": "Windows x64 debug",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}
    },
    {
      "name": "linux-x64",
      "inherits": "base",
      "displayName": "Linux x64 (gcc or clang; libcurl for https)",
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"}
    },
    {
      "name": "macos-arm64",
      "inherits": "base",
      "displayName": "macOS arm64 (Apple clang; the system libcurl for https)",
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin"},
      "cacheVariables": {"CMAKE_OSX_ARCHITECTURES": "arm64"}
    },
    {
      "name": "android-arm64",
      "inherits": "base",
      "displayName": "Android arm64 (core and engine libraries for an app; ANDROID_NDK must be set)",
      "toolchainFile": "$env{ANDROID_NDK}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {"ANDROID_ABI": "arm64-v8a", "ANDROID_PLATFORM": "android-28", "BALLRAIN_TUI": "OFF"}
    }
  ],
  "buildPresets": [
    {"name": "windows-x64", "configurePreset": "windows-x64"},
    {"name": "windows-x64-debug", "configurePreset": "windows-x64-debug"},
    {"name": "linux-x64", "configurePreset": "linux-x64"},
    {"name": "macos-arm64", "configurePreset": "macos-arm64"},
    {"name": "android-arm64", "configurePreset": "android-arm64"}
  ],
  "testPresets": [
    {"name": "windows-x64", "configurePreset": "windows-x64", "output": {"outputOnFailure": true}},
    {"name": "linux-x64", "configurePreset": "linux-x64", "output": {"outputOnFailure": true}},
    {"name": "macos-arm64", "configurePreset": "macos-arm64", "output": {"outputOnFailure": true}}
  ]
}
