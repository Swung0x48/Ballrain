+// Ballrain headless agent mode (sim/ballrain_agent.cpp): SimTool's own arguments as parse() reads them (--root,
+// --level, --boot-ticks and the --tas-* recipe with its defaults) and SimTool's legacy edit; --sock is the agent's.
+#include "ballrain_agent.h"
+static int ballrain_agent_entry(int argc, char** argv) {
+    std::vector<char*> rest{argv[0]};
+    std::string sock;
+    for (int i = 2; i < argc; ++i) {
+        if (std::string_view(argv[i]) == "--sock" && i + 1 < argc) sock = argv[++i];
+        else rest.push_back(argv[i]);
+    }
+    arguments args;
+    if (!parse(static_cast<int>(rest.size()), rest.data(), args) && !args.root.empty()) {
+        std::fprintf(stderr, "--ballrain-agent: unknown arguments\n");
+        return 2;
+    }
+    ballrain_agent_args a{};
+    a.root = args.root;
+    a.sock = sock;
+    a.level = args.level;
+    a.boot_ticks = args.boot_ticks;
+    a.offset = args.tas_offset;
+    a.reset_frame = args.tas_reset_frame;
+    a.legacy = args.tas_legacy;
+    a.movement_check = args.tas_movement_check;
+    a.seed = args.tas_seed;
+    a.reset_precision = args.tas_reset_precision;
+    a.orig_random = args.tas_orig_random;
+    a.legacy_edit = &apply_tas_legacy_edit;
+    return ballrain_agent_main(a);
+}
+
 int main(int argc, char** argv) {
+    if (argc > 1 && std::string_view(argv[1]) == "--ballrain-agent") return ballrain_agent_entry(argc, argv);
