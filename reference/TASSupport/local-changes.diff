+            auto *mgr = reinterpret_cast<CKBYTE *>(m_IpionManager);
+            auto *env = *reinterpret_cast<CKBYTE **>(mgr + o[0]);
+            *reinterpret_cast<double *>(*reinterpret_cast<CKBYTE **>(env + o[5]) + o[6]) = 0;
+            *reinterpret_cast<double *>(env + o[2]) = 0;
+            *reinterpret_cast<double *>(env + o[4]) = 0;
+            *reinterpret_cast<double *>(env + o[3]) = 1.0 / 66;
+            *reinterpret_cast<float *>(mgr + o[1]) = m_TimeManager->GetLastDeltaTime();
+            GetLogger()->Info("Physics time reset at the offsets %s (delta %f)", offsets, m_TimeManager->GetLastDeltaTime());
+            return;
+        }
