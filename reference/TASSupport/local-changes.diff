 void TASSupport::ResetPhysicsTime() {
+    GetLogger()->Info("x87 control word at the reset: %08x (precision bits %x)", _controlfp(0, 0), _controlfp(0, 0) & _MCW_PC);
+    // SIM1 patch: BallanceMMO's physics_RT (another layout) - the same reset through its bridge.
+    static const bmmo_physics_api_v2 *bmmo = [] {
+        auto fn = (bmmo_physics_api_fn) ::GetProcAddress(::GetModuleHandleA("physics_RT.dll"), BMMO_PHYSICS_API_SYMBOL);
+        // The bridge answers its own version only; the table is append-only and this mod uses early entries
+        // (the clock state), so any later version of it serves (the x87-soft branch is at v35).
+        const bmmo_physics_api_v2 *api = nullptr;
+        for (uint32_t v = BMMO_PHYSICS_API_VERSION; fn && !api && v < BMMO_PHYSICS_API_VERSION + 8; ++v) api = fn(v);
