+            GetLogger()->Error("bmmo get_clock_state: %s", error);
+            return;
+        }
+        clock.base_time = 0;
+        clock.current_time = 0;
+        clock.time_of_last_psi = 0;
+        clock.time_of_next_psi = 1.0 / 66;
