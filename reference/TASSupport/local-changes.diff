index a5ebd42..a6895f2 100644
--- a/TASSupport/TASRecord.cpp
+++ b/TASSupport/TASRecord.cpp
@@ -1,3 +1,4 @@
+#include <cstring>
 #include "TASRecord.h"
 
 #include <sstream>
@@ -472,12 +473,21 @@ void TASRecord::Load() {
 
         VectorInputStream memStream(decompressedData);
 
+        // SIM1 patch: a legacy frame is <f32 delta><u32 key bits> (Gamepiaynmo's KeyState bitfield: up, down,
+        // left, right, shift, space, q, esc, enter), not this version's 9-byte InputState.
         size_t frameCount = decompressedData.size() / (sizeof(float) + sizeof(uint32_t));
         m_Frames.resize(frameCount);
-        for (auto &frame : m_Frames) {
-            if (!frame.Deserialize(memStream)) {
-                throw std::runtime_error("Failed to deserialize a frame");
-            }
+        for (size_t i = 0; i < frameCount; ++i) {
+            float delta;
+            uint32_t bits;
+            std::memcpy(&delta, decompressedData.data() + i * 8, 4);
+            std::memcpy(&bits, decompressedData.data() + i * 8 + 4, 4);
+            auto &frame = m_Frames[i];
+            frame.deltaTime = delta;
+            auto &in = frame.inputState;
+            in.keyUp = bits & 1u; in.keyDown = bits >> 1 & 1u; in.keyLeft = bits >> 2 & 1u; in.keyRight = bits >> 3 & 1u;
+            in.keyShift = bits >> 4 & 1u; in.keySpace = bits >> 5 & 1u; in.keyQ = bits >> 6 & 1u; in.keyEsc = bits >> 7 & 1u;
+            in.keyEnter = bits >> 8 & 1u;
         }
     }
 
